# ChromoDB Environment Variables
# Copy this to .env and fill in real values

# Your Gemini API key (same one used by Jeeni server)
GEMINI_API_KEY=your_gemini_api_key_here

# Shared secret between ChromoDB and the Jeeni server
# Leave empty in dev mode to disable auth
CHROMODB_API_KEY=choose_a_strong_secret_here

# Port ChromoDB listens on (default 4000)
PORT=4000

{
  "version": 2,
  "outputDirectory": "server/public",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http://213.133.97.141:3000/api/$1"
    },
    {
      "source": "/app/((?!.*\\.[\\w]+$).*)",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/app/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/site/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(privacy|terms|app/)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(index\\.html|privacy\\.html|terms\\.html|manifest\\.json|favicon\\.ico|favicon\\.png|favicon-48x48\\.png|apple-touch-icon\\.png|app/index\\.html|app/manifest\\.json|app/favicon\\.ico|app/favicon\\.png|app/favicon-48x48\\.png|app/apple-touch-icon\\.png|app/flutter_bootstrap\\.js|app/main\\.dart\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
